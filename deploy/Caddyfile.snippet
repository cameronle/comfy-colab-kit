# Add to your existing Caddyfile. Cloudflare proxies PUBLIC_HOST (orange cloud, SSL "Full (strict)")
# and enforces Cloudflare Access (One-time PIN / SSO) in front of the native loopback gateway.
comfy.example.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
}
