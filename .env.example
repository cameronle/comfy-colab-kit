# comfy-colab-kit — environment template for native systemd / VPS batch gateway.
# Copy to .env (mode 0600) and fill in. .env is git-ignored.
# Secrets are NEVER stored inline here: reference 0600 files via *_FILE variables.

# ───────────────────────────── Public Entry ─────────────────────────────
# Protected by Cloudflare Zero Trust Access (One-time PIN / SSO) → local reverse proxy → 127.0.0.1:8080
PUBLIC_HOST=comfy.example.com

# ───────────────────────── Cloudflare Access ─────────────────────────
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
ALLOWED_EMAILS=you@example.com
OWNER_EMAILS=you@example.com
# Mode B (default): only OWNER_EMAILS can wake, switch, extend, or stop the Colab GPU
OWNER_ONLY_CONTROL=true
OWNER_ONLY_ACTIONS=wake,stop,switch,extend
# AUTH_DISABLED=false                       # true ONLY for isolated local testing

# ─────────────────────────────── Colab ───────────────────────────────
# Uses official google-colab-cli with explicit `--auth oauth2`
COLAB_BIN=/home/hermes/.local/bin/colab
# Python with google-colab-cli==0.7.5; blank uses the gateway interpreter.
# Set this explicitly when COLAB_BIN belongs to a separate uv tool environment.
COLAB_EXEC_PYTHON=
COLAB_CONNECT_TIMEOUT_S=45
# Optional XDG_CONFIG_HOME override if colab-cli lives outside ~/.config/colab-cli
COLAB_TOKEN_DIR=
COLAB_ACCELERATOR=L4
COLAB_SESSION_NAME=comfy

# ────────────────────────────── Profiles ─────────────────────────────
PROFILES=profiles/examples/moss-image,profiles/examples/sd-latest,profiles/examples/qwen-image
DEFAULT_PROFILE=moss-image
DEFAULT_VIEW=app

# ─────────────── Optional Hugging Face Read-Only Token ───────────────
# Forwarded via stdin only during model download, then scrubbed from kernel env
HF_TOKEN_FILE=

# ───────────────────────────── Cold start ────────────────────────────
FAST_START=true
DOWNLOAD_CONCURRENCY=4
XET_HIGH_PERFORMANCE=true
PIP_INSTALLER=uv
ENABLE_SMOKE_TEST=false

# ──────────────────── Keep-Warm & Spend Protection ───────────────────
WAKE_ON_VISIT=false
# Keep-warm window in minutes: reuses VRAM-resident models across consecutive jobs, then releases VM
IDLE_TIMEOUT_MIN=10
MAX_SESSION_HOURS=6
EXTEND_MAX_TIMES=1
EXTEND_HOURS=1
WARN_BEFORE_MIN=10
BOOT_TIMEOUT_MIN=40
STOP_ON_PAGE_CLOSE_MIN=0
QUIET_HOURS=
DAILY_CU_BUDGET=12
MONTHLY_CU_BUDGET=150
# Conservative 10 CU reserve floor: refuses wake when balance is unknown or <= 10 CU
MIN_CU_BALANCE=10
REQUIRE_CU_BALANCE=true
CU_PER_HOUR=1.71
ORPHAN_SWEEP_MIN=5

# ───────────────────── Local Storage & Runtime ───────────────────────
AGENT_TOKEN_FILE=
LISTEN_ADDR=127.0.0.1:8080
STATE_DIR=/var/lib/comfy-colab-kit
# Rolling cleanup for downloaded output PNGs on VPS disk
MAX_OUTPUT_FILES=100
OUTPUT_RETENTION_DAYS=3
LOG_LEVEL=info
TZ=Asia/Shanghai
